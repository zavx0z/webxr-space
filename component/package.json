{
  "name": "@zavx0z/component",
  "version": "0.0.0",
  "description": "Состояние компонентов, hooks, context, эффекты и очистка",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "sideEffects": false,
  "exports": {
