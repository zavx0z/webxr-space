{
  "name": "@zavx0z/webxr-space",
  "version": "0.1.0",
  "description": "Development superproject for the retained WebGPU/XR interface stack.",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "status": "bun scripts/status.ts",
    "graph:ui": "bun scripts/ui-component-graph.ts --write",
    "graph:ui:check": "bun scripts/ui-component-graph.ts --check",
    "catalog": "bun run graph:ui && bun catalog/server.ts",
    "catalog:typecheck": "tsc --noEmit --project tsconfig.json --pretty false",
    "catalog:test": "bun test scripts/ui-component-graph.test.ts catalog/*.test.ts",
    "catalog:build": "bun run graph:ui && bun catalog/build.ts",
    "catalog:check": "bun run graph:ui:check && bun run catalog:typecheck && bun run catalog:test && bun run catalog:build",
    "check": "bun scripts/check.ts && bun run catalog:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zavx0z/webxr-space.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@engine/core": "link:@engine/core",
    "@layout/core": "link:@layout/core",
    "@nodes/layout": "link:@nodes/layout",
    "@types/bun": "^1.4.0",
    "@ui/components": "link:@ui/components",
    "@ui/elements": "link:@ui/elements",
    "@webgpu/types": "^0.1.68",
    "@zavx0z/highlighter": "link:@zavx0z/highlighter",
    "@zavx0z/storybook": "link:@zavx0z/storybook",
    "typescript": "^7.0.2",
    "typescript-classic": "npm:typescript@6.0.3"
  }
}
