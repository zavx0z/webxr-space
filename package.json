{
  "name": "@zavx0z/webxr-space",
  "version": "0.1.0",
  "description": "Development superproject for the DOM-driven WebGPU/XR interface stack.",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "bootstrap": "bun scripts/workspace.ts bootstrap",
    "links:check": "bun scripts/workspace.ts links-check",
    "gitlinks:check": "bun scripts/workspace.ts gitlinks-check",
    "status": "bun scripts/status.ts",
    "foundation:check": "bun scripts/foundation/check.ts",
    "evidence:check": "bun scripts/foundation/check-source-evidence.ts",
    "boundaries:check": "bun scripts/foundation/check.ts --boundaries-only",
    "packages:check": "bun scripts/foundation/run-package-checks.ts",
    "packages:check:external": "bun scripts/foundation/run-package-checks.ts --include-external",
    "packages:check:plan": "bun scripts/foundation/run-package-checks.ts --plan --include-external",
    "legacy:test": "bun test scripts/workspace.test.ts",
    "legacy:check": "bun run typecheck && bun scripts/check.ts && bun run legacy:test",
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test scripts/foundation.test.ts",
    "check": "bun run typecheck && bun run foundation:check && bun run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zavx0z/webxr-space.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@engine/core": "link:@engine/core",
    "@nodes/layout": "link:@nodes/layout",
    "@types/bun": "^1.4.0",
    "@ui/components": "link:@ui/components",
    "@webgpu/types": "^0.1.68",
    "@zavx0z/highlighter": "link:@zavx0z/highlighter",
    "typescript": "^7.0.2",
    "typescript-classic": "npm:typescript@6.0.3"
  }
}
