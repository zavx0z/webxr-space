{
  "name": "@nodes/layout",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zavx0z/node.git",
    "directory": "packages/layout"
  },
  "main": "src/index.ts",
  "dependencies": {
    "@dagrejs/dagre": "3.1.1"
