    },
    "./types": {
      "types": "./types/index.ts",
      "default": "./types/index.ts"
    }
  },
  "description": "Isolated high-performance compound and top-down graph layout policies. Built for MetaFor.",
  "homepage": "https://zavx0z.github.io/node/layout/",
  "license": "MIT",
  "metafor": "https://github.com/zavx0z/metafor",
