{
  "name": "@zavx0z/webxr",
  "version": "0.0.0",
  "description": "Единая WebXR-платформа MetaFor",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": "1.4.x"
  },
  "workspaces": [
    "engine",
    "dom",
    "template",
    "component",
    "renderer",
    "webgpu",
    "browser",
    "space",
    "ui",
    "nodetree",
    "layout",
    "nodes",
    "devtools"
  ],
  "scripts": {
    "typecheck": "bun run --parallel typecheck:root typecheck:packages",
    "typecheck:root": "tsc --project tsconfig.json --pretty false",
    "typecheck:packages": "bun run --workspaces --parallel typecheck",
    "test": "bun run --parallel test:architecture test:packages",
    "test:architecture": "bun test --parallel tests/architecture/packages.test.ts tests/architecture/dependencies.test.ts tests/experience/contract.test.ts tests/migration/contract.test.ts tests/acceptance/ui-storybook.test.ts",
    "test:packages": "bun run --workspaces --parallel test",
    "check": "bun run --parallel typecheck test"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@webgpu/types": "0.1.68",
    "typescript": "7.0.2"
  }
}
