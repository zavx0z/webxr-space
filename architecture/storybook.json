{
  "schemaVersion": 1,
  "lifecycleOwner": "external-storybook",
  "workspaceManifest": ".storybook/manifest.json",
  "constraints": {
    "dataOnly": true,
    "ownsServer": false,
    "ownsRuntime": false,
    "ownsCatalog": false,
    "ownsStories": false,
    "allowsStorybookDependency": false
  },
  "transitionDeclarations": [
    {
      "id": "engine",
      "reference": "../projects/engine/.storybook/manifest.json",
      "owner": "source:engine",
      "state": "external-pinned"
    },
    {
      "id": "ui",
      "reference": "../projects/ui/.storybook/manifest.json",
      "owner": "source:ui",
      "state": "external-pinned"
    },
    {
      "id": "nodes",
      "reference": "../projects/node/.storybook/manifest.json",
      "owner": "source:node",
      "state": "external-node-gated"
    }
  ],
  "independentAttachments": [
    {
      "id": "renderer",
      "repository": "renderer",
      "path": ".storybook/manifest.json",
      "owner": "source:renderer",
      "state": "external"
    }
  ],
  "cutoverRule": "A declaration moves with its production package owner; the workspace never recreates stories or runtime code."
}
