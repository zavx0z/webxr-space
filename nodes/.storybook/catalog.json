              "route": "layout/fixed/baseline/right",
              "module": {
                "path": "./stories/subjects/layout.ts",
                "export": "story_fixed_baseline_right"
              }
            },
            {
              "id": "baseline-down",
              "label": "Базовая · DOWN",
              "group": {"id": "baseline", "label": "Базовая топология"},
              "route": "layout/fixed/baseline/down",
