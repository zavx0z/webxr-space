{
  "name": "@webxr/nodes",
  "label": "Нодовая система",
  "version": "0.0.0",
  "description": "Общее представление GraphView, GraphEditor, Frame и Link",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "tree",
    "layout",
    "parameters",
    "sockets",
    "node"
  ],
  "exports": {
    "./view": "./view/index.tsx",
    "./view/tree": "./view/tree.ts",
    "./editor": "./editor/index.tsx",
    "./frame": "./frame/index.tsx",
    "./link": "./link/index.tsx"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test --parallel ./tests ./frame/tests ./view/tests",
    "check": "bun run --parallel typecheck test"
  },
  "peerDependencies": {
    "@zavx0z/component": "*",
    "@zavx0z/dom": "*",
    "@nodes/layout": "*",
    "@nodes/tree": "*",
    "@nodes/parameters": "*",
    "@nodes/sockets": "*",
    "@zavx0z/template": "*",
    "@zavx0z/ui": "*",
    "@nodes/node": "*"
  },
  "peerDependenciesMeta": {
    "@nodes/parameters": {
      "optional": true
    },
    "@nodes/sockets": {
      "optional": true
    },
    "@zavx0z/component": {
      "optional": true
    },
    "@zavx0z/dom": {
      "optional": true
    },
    "@nodes/layout": {
      "optional": true
    },
    "@nodes/tree": {
      "optional": true
    },
    "@zavx0z/template": {
      "optional": true
    },
    "@zavx0z/ui": {
      "optional": true
    },
    "@nodes/node": {
      "optional": true
    }
  }
}
