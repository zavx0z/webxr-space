{
  "name": "@webxr/nodes",
  "label": "Нодовая система",
  "version": "0.0.0",
  "description": "Визуальные NodeTree, NodeEditor, Frame, Node, Parameter, Socket и Link",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.4.0",
  "workspaces": ["tree", "layout", "parameters", "sockets"],
  "exports": {
    "./node-tree": "./node-tree/src/node-tree.tsx",
    "./node-editor": "./node-editor/src/node-editor.tsx",
    "./frame": "./frame/src/frame.tsx",
    "./node": "./node/src/node.tsx",
    "./link": "./link/src/link.tsx"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test --parallel ./tests ./node/tests ./frame/tests ./node-tree/tests",
    "check": "bun run --parallel typecheck test"
  },
  "peerDependencies": {
    "@zavx0z/component": "*",
    "@zavx0z/dom": "*",
    "@nodes/layout": "*",
    "@nodes/tree": "*",
    "@nodes/parameters": "*",
    "@nodes/sockets": "*",
    "@zavx0z/template": "*",
    "@zavx0z/ui": "*"
  },
  "peerDependenciesMeta": {
    "@nodes/parameters": {"optional": true},
    "@nodes/sockets": {"optional": true},
    "@zavx0z/component": {"optional": true},
    "@zavx0z/dom": {"optional": true},
    "@nodes/layout": {"optional": true},
    "@nodes/tree": {"optional": true},
    "@zavx0z/template": {"optional": true},
    "@zavx0z/ui": {"optional": true}
  }
}
