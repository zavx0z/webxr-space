{
  "name": "@nodes/parameters",
  "label": "Параметры",
  "version": "0.0.0",
  "description": "Представления параметров нод и проекция Parameter Store",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.4.0",
  "exports": {
    "./text": "./text/text/src/text.tsx",
