    "./slider": "./numeric/slider/src/slider.tsx",
    "./checkbox": "./boolean/checkbox/src/checkbox.tsx",
    "./switch": "./boolean/switch/src/switch.tsx",
    "./select": "./choice/select/src/select.tsx",
    "./cycle": "./choice/cycle/src/cycle.tsx",
    "./option-group": "./choice/option-group/src/option-group.tsx",
    "./color": "./composite/color/src/color.tsx",
    "./vector": "./composite/vector/src/vector.tsx",
    "./matrix": "./composite/matrix/src/matrix.tsx",
    "./path": "./references/path/src/path.tsx",
    "./reference": "./references/reference/src/reference.tsx",
    "./collection": "./collections/collection/src/collection.tsx",
    "./output": "./output/output/src/output.tsx",
    "./shared": "./shared/parameter/src/parameter.tsx"
