    "./number": "./numeric/number/index.tsx",
    "./slider": "./numeric/slider/index.tsx",
    "./checkbox": "./boolean/checkbox/index.tsx",
    "./switch": "./boolean/switch/index.tsx",
    "./select": "./choice/select/index.tsx",
    "./cycle": "./choice/cycle/index.tsx",
    "./option-group": "./choice/option-group/index.tsx",
    "./color": "./composite/color/index.tsx",
    "./vector": "./composite/vector/index.tsx",
    "./matrix": "./composite/matrix/index.tsx",
    "./path": "./references/path/index.tsx",
    "./reference": "./references/reference/index.tsx",
