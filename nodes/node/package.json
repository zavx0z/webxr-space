{
  "name": "@nodes/node",
  "label": "Ноды",
  "version": "0.0.0",
  "description": "DiagramNode, ParameterNode и ContentNode на основе Pane",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.4.0",
  "exports": {
    "./diagram": "./diagram/index.tsx",
    "./parameter": "./parameter/index.tsx",
    "./content": "./content/index.tsx",
    "./image": "./image/index.tsx",
    "./surface": "./surface/index.tsx",
    "./contents": "./contents/index.tsx",
    "./geometry": "./shared/geometry.ts",
    "./contracts": "./shared/contracts.ts",
    "./metrics": "./shared/metrics.ts"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test --parallel tests diagram/spec diagram/tests content/spec parameter/spec image/spec surface/spec contents/spec",
    "check": "bun run --parallel typecheck test"
  },
  "peerDependencies": {
    "@nodes/tree": "*",
    "@nodes/parameters": "*",
    "@nodes/sockets": "*",
    "@zavx0z/component": "*",
    "@zavx0z/template": "*",
    "@zavx0z/ui": "*"
  },
  "peerDependenciesMeta": {
    "@nodes/tree": {
      "optional": true
    },
    "@nodes/parameters": {
      "optional": true
    },
    "@nodes/sockets": {
      "optional": true
    },
    "@zavx0z/component": {
      "optional": true
    },
    "@zavx0z/template": {
      "optional": true
    },
    "@zavx0z/ui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@immersive/headless": "*"
  }
}
