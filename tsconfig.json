{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun", "@webgpu/types"]
  },
  "include": [
    "scripts/**/*.ts",
    "packages/storybook/**/*.ts",
    "graphs/**/*.json"
  ],
  "exclude": ["projects/**", "dist/**"]
}
