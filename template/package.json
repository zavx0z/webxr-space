{
  "name": "@zavx0z/template",
  "version": "0.0.0",
  "description": "Компилятор TSX и формат готового шаблона",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "sideEffects": false,
  "exports": {
    ".": "./index.ts",
    "./compiled": "./compiled.ts",
    "./compiler": "./compiler/index.ts",
    "./bun": "./compiler/bun.ts",
    "./jsx-runtime": "./jsx-runtime.ts",
    "./jsx-dev-runtime": "./jsx-dev-runtime.ts"
  },
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --pretty false",
    "test": "bun test --parallel tests",
    "check": "bun run --parallel typecheck test"
  },
  "peerDependencies": {
    "@zavx0z/dom": "*",
    "typescript": "7.0.2"
  },
  "peerDependenciesMeta": {
    "@zavx0z/dom": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  }
}
